# Connections and runtime knobs only — selectors and per-source behaviour
# live in config/sources.yaml, not here.

# Sources/sections config file (default shown; override for a different path)
# KEDRA_CONFIG_PATH=config/sources.yaml

# Mongo. Dev compose creates three users (docker/mongo-init.js):
#   spider    — readWrite landing_zone + meta
#   transform — read landing_zone, readWrite transformed + meta
#   ingest_admin — readWrite everything (dev default)
KEDRA_MONGO_URI=mongodb://ingest_admin:ingest_admin@localhost:27017/?authSource=admin
KEDRA_LANDING_DB=landing_zone
KEDRA_TRANSFORMED_DB=transformed
KEDRA_META_DB=meta

# MinIO
KEDRA_MINIO_ENDPOINT=localhost:9000
KEDRA_MINIO_ACCESS_KEY=minioadmin
KEDRA_MINIO_SECRET_KEY=minioadmin
KEDRA_MINIO_SECURE=false
KEDRA_LANDING_BUCKET=landing-zone
KEDRA_TRANSFORMED_BUCKET=transformed

# Runtime logging. Source crawl behavior lives in config/sources.yaml.
KEDRA_LOG_LEVEL=INFO
